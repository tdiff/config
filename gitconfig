[url "git@gitlab.nebius.dev:"]
	insteadOf = https://gitlab.nebius.dev/
[protocol]
	version = 2
[user]
	name = A.Dmitrovsky
	email = anton.dmitrovsky@nebius.com
[core]
	autocrlf = input
	whitespace = trailing-space,space-before-tab
	editor = vim
	pager = "less -F -X"
[log]
	date = iso
[branch]
	autosetuprebase = remote
[diff]
	algorithm = histogram
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = upstream
[rebase]
	autosquash = true
	autostash = true
[alias]
	s = status -uno
	ss = status
	stat = show --name-only
	l = log --decorate=short --max-count=10 --pretty=oneline --graph
	ll = log --decorate=short --max-count=10 --pretty=short --graph
	co = checkout
	br = branch
	brr = branch -vv
	d = diff
	dc = diff --check
	di = diff --cached
	dic = diff --cached --check
	cp = cherry-pick
	cm = commit -m
	cf = commit --fixup
[color]
	ui = auto
